# next-auth@beta declares an OPTIONAL nodemailer ^7||^8 peer (used only by its
# Email provider, which Cumulet does not use). We ship nodemailer 9 for a
# security fix, so npm's strict peer resolution would otherwise ERESOLVE on a
# fresh install. This keeps `npm install` / `npm ci` working out of the box.
legacy-peer-deps=true
