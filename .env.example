# --- Database ---
DATABASE_URL="mysql://cumulet:password@localhost:3306/cumulet"

# --- Auth.js ---
# App canonical URL (also used for WebAuthn RP ID/origin and email links)
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# OIDC is configured in the SUPER_ADMIN Settings page.
# Legacy OIDC_ISSUER / OIDC_CLIENT_ID / OIDC_CLIENT_SECRET values are read only
# as a migration fallback until an OIDC setting has been saved to the database.

# --- Secrets encryption (AES-256-GCM) ---
# openssl rand -hex 32  (64 hex chars = 32 bytes)
APP_ENCRYPTION_KEY=""

# --- i18n ---
DEFAULT_LOCALE="zh"
# Self-hosted scheduler (production server only). AI provider settings live in DB.
AI_CRON_ENABLED="true"
LIFECYCLE_CRON_ENABLED="true"
# Keep false unless webhook receivers intentionally live on private networks.
ALLOW_PRIVATE_OUTBOUND_WEBHOOKS="false"

# OIDC, PVE nodes, JumpServer, SMTP, default quotas and provisioning defaults are
# configured in the database via the admin Settings pages, not here.

# ===========================================================================
# Docker Compose only (ignored by local `npm run dev`). `docker compose` reads
# this file for ${...} substitution; the app container builds its own
# DATABASE_URL from the MySQL vars below, so DATABASE_URL above is not used.
# ===========================================================================
MYSQL_ROOT_PASSWORD=""
MYSQL_DATABASE="cumulet"
MYSQL_USER="cumulet"
MYSQL_PASSWORD=""
# Optional when the password needs URL encoding (for example, contains @ or :):
DOCKER_DATABASE_URL=""
APP_PORT="3000"
# First boot only: seed a SUPER_ADMIN + the default form, then set back to false.
SEED_ON_START="false"
SEED_ADMIN_EMAIL=""
# Required when SEED_ON_START=true: 12+ characters containing letters and numbers.
SEED_ADMIN_PASSWORD=""
