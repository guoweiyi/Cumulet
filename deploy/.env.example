IMAGE="xiaoxiaoyunmiao/cumulet:latest"

NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# openssl rand -hex 32
APP_ENCRYPTION_KEY=""

# i18n: zh or en
DEFAULT_LOCALE="zh"
# Self-hosted schedulers (production server only). AI provider settings live in DB.
AI_CRON_ENABLED="true"
LIFECYCLE_CRON_ENABLED="true"
# Keep false unless webhook receivers intentionally live on private networks.
ALLOW_PRIVATE_OUTBOUND_WEBHOOKS="false"

APP_PORT="3000"

# --- Mode A: one-click (deploy/docker-compose.yml) --------------------------
# Compose spins up MySQL 8 alongside the app. Fill all three values below.
MYSQL_ROOT_PASSWORD=""
MYSQL_DATABASE="cumulet"
MYSQL_USER="cumulet"
MYSQL_PASSWORD=""
# Optional: set explicitly when the password needs URL encoding (contains @ or :).
DOCKER_DATABASE_URL=""

# --- Mode B: existing database (deploy/docker-compose.external-db.yml) ------
# Point at your existing MySQL 8 instance. The DB must already exist and be
# reachable from the container (host.docker.internal for a host-side DB).
EXTERNAL_DATABASE_URL="mysql://cumulet:password@dbhost:3306/cumulet"

SEED_ON_START="true"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
