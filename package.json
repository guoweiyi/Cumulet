{
  "name": "cumulet",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/harden-next-postcss.mjs",
    "generate:openapi": "node --import tsx scripts/generate-openapi.ts",
    "dev": "npm run generate:openapi && node server.js",
    "build": "npm run generate:openapi && next build --webpack",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint",
    "dev:turbo": "npm run generate:openapi && next dev",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@novnc/novnc": "^1.7.0",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/browser": "^9.0.1",
    "@simplewebauthn/server": "^9.0.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.49.0",
    "postcss": "8.5.23",
    "prisma": "^6.19.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swagger-ui-react": "^5.32.11",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.9.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "next-swagger-doc": "^0.4.1",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
